{
  // Launch profiles for the runnable projects in this workspace.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker Compose: SkyNet API Core",
      "type": "docker",
      "request": "attach",
      "platform": "netCore",
      "containerName": "skynet-api-core",
      "preLaunchTask": "compose: up debug",
      "postDebugTask": "compose: down debug",
      "sourceFileMap": {
        "/src": "${workspaceFolder}"
      }
    },
    {
      "name": "SkyNet API Core",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "clean and build: SkyNetApiCore",
      "program": "${workspaceFolder}/SkyNetApiCore/bin/Debug/net10.0/SkyNetApiCore.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SkyNetApiCore",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000"
      },
      "console": "internalConsole"
    },
    {
      "name": "Skynet Products API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: SkynetProductsApi",
      "program": "${workspaceFolder}/SkynetProductsApi/bin/Debug/net10.0/SkynetProductsApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SkynetProductsApi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5002"
      },
      "console": "internalConsole"
    },
    {
      "name": "SkyNet Order gRPC",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: SkyNetOrderGrpc",
      "program": "${workspaceFolder}/SkyNetOrderGrpc/bin/Debug/net10.0/SkyNetOrderGrpc.dll",
      "args": [],
      "cwd": "${workspaceFolder}/SkyNetOrderGrpc",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5132"
      },
      "console": "internalConsole"
    },
    {
      "name": "Integration Core Console",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "clean and build: IntegrationCoreConsole",
      "program": "${workspaceFolder}/IntegrationCoreConsole/bin/Debug/net10.0/IntegrationCoreConsole.dll",
      "args": [],
      "cwd": "${workspaceFolder}/IntegrationCoreConsole",
      "stopAtEntry": false,
      "env": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "console": "internalConsole"
    }
  ]
}
